# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local SQLite database — this is your actual DSA data, back it up manually
# (see Part 9 of the product plan: `cp dev.db` to a synced folder after sessions)
/dev.db
/dev.db-journal
# a stray empty prisma/dev.db can appear if a prisma command ever runs without
# DATABASE_URL set — it's never the real data (that's always /dev.db above),
# but ignore it so it can't be accidentally committed.
/prisma/dev.db

# uploaded PDFs — also your data, not source; back this folder up alongside dev.db
/storage

# Prisma CLI's auto-installed per-editor "AI skill" docs (not app code)
/.claude/skills
/.agents
/.windsurf
/skills-lock.json
