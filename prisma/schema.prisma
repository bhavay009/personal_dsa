generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Problem {
  id          Int                 @id @default(autoincrement())
  title       String
  url         String?
  pattern     String
  difficulty  String // Easy | Medium | Hard
  status      String              @default("Unsolved") // Solved | Unsolved | Attempted
  notes       String?
  createdAt   DateTime            @default(now())
  attempts    Attempt[]
  predictions PatternPrediction[]
  hints       HintEvent[]

  // SM-2 spaced-repetition state (lives on the card, not the attempt)
  easeFactor   Float @default(2.5)
  intervalDays Float @default(0)
  repetitions  Int   @default(0)
}

model Exam {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  createdAt DateTime @default(now())
}

model Document {
  id            Int      @id @default(autoincrement())
  filename      String // stored filename on disk (uuid-based)
  originalName  String
  folder        String // subject/topic grouping, free text
  sizeBytes     Int
  uploadedAt    DateTime @default(now())
  docType       String   @default("Notes") // Notes | PYQ | Resume
  extractedText String? // plain text pulled from the PDF, powers Ask My Notes (FTS5) + resume analysis

  @@index([folder])
  @@index([docType])
}

model Subject {
  id          Int          @id @default(autoincrement())
  name        String
  semester    String?
  createdAt   DateTime     @default(now())
  topics      Topic[]
  assignments Assignment[]
}

model Topic {
  id          Int       @id @default(autoincrement())
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   Int
  name        String
  confidence  Int       @default(0) // 0-100, self-rated
  lastRevised DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectId])
}

model Assignment {
  id          Int       @id @default(autoincrement())
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   Int
  title       String
  deadline    DateTime
  priority    String    @default("Medium") // Low | Medium | High
  status      String    @default("Pending") // Pending | Done
  estimateMin Int?
  createdAt   DateTime  @default(now())

  @@index([subjectId])
}

model Skill {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  category       String // Frontend | Backend | Database | DevOps | Tools | Other
  learned        Boolean  @default(false)
  practiced      Boolean  @default(false)
  built          Boolean  @default(false)
  explained      Boolean  @default(false)
  interviewReady Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Project {
  id           Int                 @id @default(autoincrement())
  name         String
  description  String?
  techStack    String?
  architecture String?
  challenges   String?
  decisions    String?
  githubUrl    String?
  liveUrl      String?
  createdAt    DateTime            @default(now())
  questions    InterviewQuestion[]
  sessions     InterviewSession[]
}

model InterviewQuestion {
  id         Int      @id @default(autoincrement())
  category   String // DSA | JS | React | Node | SQL | DBMS | OS | CN | OOP | SystemDesign | Behavioral | Project
  difficulty String   @default("Medium") // Easy | Medium | Hard | Advanced
  question   String
  projectId  Int?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([projectId])
}

model InterviewSession {
  id        Int      @id @default(autoincrement())
  mode      String // DSA | JS | React | Node | SQL | DBMS | OS | CN | OOP | SystemDesign | Behavioral | Project | Mixed
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date      DateTime @default(now())
  totalQ    Int
  correctQ  Int
  notes     String?

  @@index([mode])
}

model Application {
  id            Int       @id @default(autoincrement())
  company       String
  role          String
  url           String?
  stage         String    @default("Saved") // Saved | Applied | OA | Technical | HR | Offer | Rejected
  appliedDate   DateTime?
  interviewDate DateTime?
  referral      Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([stage])
}

// ---------- Coach: adaptive session engine (§6, §7) ----------

model SessionPlan {
  id      Int            @id @default(autoincrement())
  date    DateTime       @default(now())
  goalMin Int
  status  String         @default("Active") // Active | Completed
  blocks  SessionBlock[]

  @@index([date])
}

model SessionBlock {
  id        Int         @id @default(autoincrement())
  plan      SessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    Int
  position  Int
  kind      String // Recall | Drill | NewProblem | Transfer | Revision | Timed
  minutes   Int
  pattern   String?
  problemId Int?
  // Plain-English justification tied to real evidence. §10: the score must be
  // explainable — a block the learner can't interrogate is indistinguishable
  // from a random suggestion.
  rationale String
  status    String      @default("Pending") // Pending | Done | Skipped

  @@index([planId])
}

// Pattern-recognition training (§11). Prediction is recorded BEFORE the attempt,
// so recognition can be scored independently of whether the problem was solved.
model PatternPrediction {
  id        Int      @id @default(autoincrement())
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId Int
  predicted String
  actual    String
  correct   Boolean
  createdAt DateTime @default(now())

  @@index([problemId])
}

// Hint telemetry (§8). secondsBefore is the time spent struggling before asking,
// which distinguishes "stuck and thinking" from "reflexively reaching for help".
model HintEvent {
  id            Int      @id @default(autoincrement())
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId     Int
  level         Int // 0-8, see lib/hints.ts
  secondsBefore Int
  createdAt     DateTime @default(now())

  @@index([problemId])
}

model Attempt {
  id           Int       @id @default(autoincrement())
  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId    Int
  date         DateTime  @default(now())
  outcome      String // Solved | Failed | Partial
  mistakeTag   String? // concept | pattern-recognition | logic | coding | edge-case |
  // time-complexity | space-complexity | misread | needed-hint | needed-solution |
  // forgot-concept | time-management
  timeTakenMin Int?
  nextRevision DateTime?

  @@index([problemId])
  @@index([nextRevision])
}
